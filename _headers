/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Keep HTML, modules and manifests on Cloudflare's default revalidation policy.
# Atlas URLs carry their source hashes; a short browser cache avoids repeat
# downloads without retaining changed imagery for a whole season.
/data/maps/raster-v2/*.webp
  Cache-Control: public, max-age=86400
/data/paleomap/owners-:age-:size.png
  Cache-Control: public, max-age=86400
