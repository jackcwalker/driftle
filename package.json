{
  "name": "driftle",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-site.mjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 4174",
    "deploy": "wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:preview": "wrangler versions upload"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22"
  }
}
